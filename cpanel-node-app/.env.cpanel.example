# cPanel Node.js application
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
NEXT_OUTPUT_MODE=server

# Public URL of the domain or subdomain configured in cPanel
NEXT_PUBLIC_API_BASE_URL=https://ceiscaramulo.seudominio.com

# PostgreSQL on cPanel usually uses a prefixed database and user name
# Example: username_dbname / username_dbuser
DATABASE_URL=postgresql://cpaneluser_dbuser:STRONG_PASSWORD@localhost:5432/cpaneluser_dbname?schema=public
DATABASE_URL_UNPOOLED=postgresql://cpaneluser_dbuser:STRONG_PASSWORD@localhost:5432/cpaneluser_dbname?schema=public

# Admin auth for the backoffice
ADMIN_EMAILS=admin@seudominio.com
ADMIN_AUTH_SECRET=troque-esta-chave-por-uma-chave-longa
ADMIN_AUTH_PASSWORD=troque-esta-password

# Keep runtime mode on cPanel Node.js so auth and APIs stay server-side
NEXT_PUBLIC_ADMIN_AUTH_MODE=runtime

# Optional local uploads
STORAGE_PROVIDER=local
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_PATH=/uploads
