DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-PGBOUNCER.neon.tech/ceiscaramulo?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/ceiscaramulo?sslmode=require"
PORT=3001
NEXT_OUTPUT_MODE="server"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
VITE_API_BASE_URL="http://localhost:3001"

# Opcional: restringe o backoffice a emails específicos
ADMIN_EMAILS="admin@ceiscaramulo.pt"
ADMIN_AUTH_SECRET="troque-esta-chave-por-uma-chave-longa"
ADMIN_AUTH_PASSWORD="troque-esta-password"

# Ative este modo apenas para output estático/export
NEXT_PUBLIC_ADMIN_AUTH_MODE="runtime"
NEXT_PUBLIC_ADMIN_EXPORT_EMAIL="admin@ceiscaramulo.pt"
NEXT_PUBLIC_ADMIN_EXPORT_PASSWORD_SHA256=""
NEXT_PUBLIC_ADMIN_EXPORT_ROLE="owner"
NEXT_PUBLIC_ADMIN_EXPORT_PERMISSIONS="news,activities,projects,publications,gallery,layout,admins,audit"

# Opcional: configuração do armazenamento local de uploads
STORAGE_PROVIDER="local"
UPLOADS_DIR="uploads"
UPLOADS_PUBLIC_PATH="/uploads"
